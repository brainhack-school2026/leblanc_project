posthoc_ct_dsk_pente <- posthoc_ct_dsk_pente %>%
mutate(region = recode(region,
"mr_y_smri__thk__dsk__bstmps" = "banks of superior temporal sulcus",
"mr_y_smri__thk__dsk__cac"    = "caudal anterior cingulate",
"mr_y_smri__thk__dsk__cmfrt"  = "caudal middle frontal",
"mr_y_smri__thk__dsk__cn"     = "cuneus",
"mr_y_smri__thk__dsk__er"     = "entorhinal",
"mr_y_smri__thk__dsk__ff"     = "fusiform",
"mr_y_smri__thk__dsk__ic"     = "isthmuscingulate",
"mr_y_smri__thk__dsk__ins"    = "insula",
"mr_y_smri__thk__dsk__iprt"   = "inferior parietal",
"mr_y_smri__thk__dsk__itmp"   = "inferior temporal",
"mr_y_smri__thk__dsk__lg"     = "lingual",
"mr_y_smri__thk__dsk__lobfrt" = "lateral orbitofrontal",
"mr_y_smri__thk__dsk__locc"   = "lateral occipital",
"mr_y_smri__thk__dsk__mobfrt" = "medial orbitofrontal",
"mr_y_smri__thk__dsk__mtmp"   = "middle temporal",
"mr_y_smri__thk__dsk__pactr"  = "paracentral",
"mr_y_smri__thk__dsk__pcc"    = "pericalcarine",
"mr_y_smri__thk__dsk__pcg"    = "posterior cingulate",
"mr_y_smri__thk__dsk__pfrt"   = "frontal pole",
"mr_y_smri__thk__dsk__ph"     = "parahippocampal",
"mr_y_smri__thk__dsk__pob"    = "pars orbitalis",
"mr_y_smri__thk__dsk__poctr"  = "postcentral",
"mr_y_smri__thk__dsk__pop"    = "pars opercularis",
"mr_y_smri__thk__dsk__prcn"   = "precuneus",
"mr_y_smri__thk__dsk__prctr"  = "precentral",
"mr_y_smri__thk__dsk__ptg"    = "pars triangularis",
"mr_y_smri__thk__dsk__ptmp"   = "temporal pole",
"mr_y_smri__thk__dsk__rac"    = "rostral anterior cingulate",
